{% assign rekart_url = block.settings.rekart_base_url %}
{% assign product_id = product.id %}
{% assign shop = shop.permanent_domain %}

<div id="rekart-subscribe-wrapper">
  <a
    href="{{ rekart_url }}/subscribe?shop={{ shop }}&product_id={{ product_id }}&plan=daily"
    class="rekart-subscribe-btn"
    style="
      display: inline-block;
      background-color: #2c6e49;
      color: white;
      padding: 12px 24px;
      border-radius: 6px;
      text-decoration: none;
      font-size: 16px;
      font-weight: bold;
      margin-top: 12px;
    "
  >
    🥛 Subscribe via Rekart
  </a>
  <p style="font-size: 12px; color: #666; margin-top: 6px;">Daily delivery · Managed by Rekart</p>
</div>

{% schema %}
{
  "name": "Rekart Subscribe Button",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "rekart_base_url",
      "label": "Rekart Base URL",
      "default": "http://localhost:8000"
    }
  ]
}
{% endschema %}
